# Database
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# JWT
JWT_SECRET="generate-a-secure-random-secret-key"
JWT_EXPIRATION="8h"

# Server
PORT=3001
NODE_ENV=development

# CNPJ API
CNPJ_API_URL="https://brasilapi.com.br/api/cnpj/v1"

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Fuso do negócio — usado para renderizar datas na página pública do orçamento.
# O servidor roda em UTC em produção, então sem isso a validade aparece com a
# data do dia seguinte. Precisa ser igual ao NEXT_PUBLIC_BUSINESS_TIME_ZONE
# do frontend. Ex: America/Manaus (UTC-4), America/Sao_Paulo, America/Belem.
BUSINESS_TIME_ZONE="America/Manaus"

# ─── Módulo Fiscal ──────────────────────────────────────────────────────────
# Certificado A1 (.pfx) para assinatura digital XMLDSIG
# Coloque o arquivo .pfx na raiz do projeto ou em /certs
CERT_PFX_PATH="./certs/certificado.pfx"
CERT_PFX_PASSWORD=""

# URL do portal principal que receberá os webhooks de NF-e/NFS-e
WEBHOOK_PORTAL_URL="http://localhost:3000/api/webhooks/fiscal"
