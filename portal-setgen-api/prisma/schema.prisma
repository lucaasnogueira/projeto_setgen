generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                     @id @default(uuid())
  name                     String
  email                    String                     @unique
  password                 String
  role                     UserRole
  active                   Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  roleId                   String?
  notifyPrefs              Json?
  auvochatEnabled          Boolean                    @default(false)
  avatarUrl                String?
  basePointAddress         String?
  basePointLat             Float?
  basePointLng             Float?
  checkinType              CheckinType                @default(MANUAL)
  defaultScreen            DefaultScreen              @default(AGENDA)
  hourlyRate               Decimal                    @default(0.00) @db.Decimal(12, 2)
  jobTitle                 String?
  kmRate                   Decimal                    @default(0.00) @db.Decimal(12, 2)
  language                 String                     @default("pt-BR")
  login                    String?                    @unique
  monitoringIntervalMin    Int                        @default(3)
  notifyApprovalEmail      Boolean                    @default(true)
  notifyApprovalWeb        Boolean                    @default(true)
  phone                    String?
  workShiftSchedule        Json?
  workShiftType            WorkShiftType              @default(SEMPRE_ATIVO)
  approvals                Approval[]
  auditLogs                AuditLog[]
  clientsResponsibleFor    Client[]                   @relation("ClientResponsibleUser")
  collaboratorAttachments  CollaboratorAttachment[]
  collaboratorPermissions  CollaboratorPermission?
  deliveredServices        Delivery[]                 @relation("DeliveredBy")
  employee                 Employee?
  expenseAttachments       ExpenseAttachment[]
  approvedExpenses         Expense[]                  @relation("ApprovedExpenses")
  expenses                 Expense[]                  @relation("UserExpenses")
  fuelRequestsApproved     FuelRequest[]              @relation("FuelApprovedBy")
  fuelRequestsMade         FuelRequest[]              @relation("FuelRequestedBy")
  createdNotasFiscais      NotaFiscal[]               @relation("CreatedNotasFiscais")
  collaboratorStocks       ProductCollaboratorStock[]
  uploadedPurchaseOrders   PurchaseOrder[]            @relation("UploadedPurchaseOrders")
  quoteAttachmentsUploaded QuoteAttachment[]          @relation("QuoteAttachmentUploader")
  quoteTasksAssigned       QuoteTask[]                @relation("QuoteTaskAssignee")
  createdQuotes            Quote[]                    @relation("CreatedQuotes")
  salesQuotes              Quote[]                    @relation("QuoteSalesRep")
  assignedWorkOrders       ServiceOrder[]             @relation("AssignedWorkOrders")
  createdServiceOrders     ServiceOrder[]             @relation("CreatedServiceOrders")
  stockMovements           StockMovement[]
  requestedVisits          TechnicalVisit[]           @relation("VisitRequestedBy")
  createdVisits            TechnicalVisit[]           @relation("CreatedVisits")
  permissions              UserPermission[]
  roleRef                  Role?                      @relation(fields: [roleId], references: [id])
  createdVehicleTrips      VehicleTrip[]
  workOrderExecutionLogs   WorkOrderExecutionLog[]
  managedTeams             Team[]                     @relation("TeamManagers")
  teams                    Team[]                     @relation("TeamMembers")
  createdDocuments         ServiceOrderDocument[]

  @@map("users")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  moduleId    String?
  module      SystemModule?    @relation(fields: [moduleId], references: [id])
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model SystemModule {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String?
  route       String
  icon        String       @default("Layers")
  orderIndex  Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@map("system_modules")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model CollaboratorPermission {
  id                                  String   @id @default(uuid())
  userId                              String   @unique
  canCreateTasks                      Boolean  @default(false)
  canAccessAllTaskTypes               Boolean  @default(false)
  canExecuteTasks                     Boolean  @default(true)
  canEditTasks                        Boolean  @default(false)
  canDeleteTasks                      Boolean  @default(false)
  canRemoveCollectedSignature         Boolean  @default(false)
  canPauseTasks                       Boolean  @default(true)
  canRescheduleTasks                  Boolean  @default(false)
  canUseGalleryPhotos                 Boolean  @default(true)
  canEditTasksPostCheckout            Boolean  @default(false)
  canManualCheckoutWithPending        Boolean  @default(false)
  canManualCheckinWithOpenCheckout    Boolean  @default(false)
  canFillReportWithoutCheckin         Boolean  @default(false)
  canManualCheckinOffSchedule         Boolean  @default(false)
  canAddQuestionnaire                 Boolean  @default(false)
  canRemoveQuestionnaire              Boolean  @default(false)
  canRemoveEquipmentFromQuestionnaire Boolean  @default(false)
  canChangeBasePoint                  Boolean  @default(false)
  canManageClients                    Boolean  @default(false)
  canAccessProductsAndQuotes          Boolean  @default(false)
  canEditClientAddress                Boolean  @default(false)
  canChangeQuoteStatus                Boolean  @default(false)
  canViewClientSensitiveContacts      Boolean  @default(false)
  canViewSendDigitalOsReports         Boolean  @default(false)
  canManageFinancialCategories        Boolean  @default(false)
  canStartDisplacement                Boolean  @default(true)
  canViewCostPrices                   Boolean  @default(false)
  canMoveCompanyStock                 Boolean  @default(false)
  canManageKeywords                   Boolean  @default(false)
  canManageProjects                   Boolean  @default(false)
  canViewEquipment                    Boolean  @default(true)
  canCreateEquipment                  Boolean  @default(false)
  canEditEquipment                    Boolean  @default(false)
  canDeleteEquipment                  Boolean  @default(false)
  canDeleteTicketNotes                Boolean  @default(false)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
  user                                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("collaborator_permissions")
}

model CollaboratorAttachment {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  fileUrl    String
  fileSize   BigInt?
  mimeType   String?
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("collaborator_attachments")
}

model Client {
  id                    String            @id @default(uuid())
  cnpjCpf               String            @unique
  companyName           String
  tradeName             String?
  address               Json
  phone                 String
  email                 String
  contacts              Json[]
  status                ClientStatus      @default(ACTIVE)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  billingEmail          String?
  corporateEmails       String[]          @default([])
  corporatePhones       String[]          @default([])
  externalCode          String?           @unique
  groupId               String?
  icmsTaxpayerType      IcmsTaxpayerType?
  internalNotes         String?
  latitude              Float?
  longitude             Float?
  municipalRegistration String?
  onSiteContact         String?
  responsibleTeamId     String?
  responsibleUserId     String?
  segmentId             String?
  stateRegistration     String?
  isPublicAgency        Boolean           @default(false)
  addresses             ClientAddress[]
  contactList           ClientContact[]
  group                 ClientTaxonomy?   @relation("ClientGroupTaxonomy", fields: [groupId], references: [id])
  responsibleTeam       Team?             @relation(fields: [responsibleTeamId], references: [id])
  responsibleUser       User?             @relation("ClientResponsibleUser", fields: [responsibleUserId], references: [id])
  segment               ClientTaxonomy?   @relation("ClientSegmentTaxonomy", fields: [segmentId], references: [id])
  equipments            Equipment[]
  expenses              Expense[]
  notasFiscais          NotaFiscal[]
  purchaseOrders        PurchaseOrder[]
  quotes                Quote[]
  serviceOrders         ServiceOrder[]
  technicalVisits       TechnicalVisit[]
  documents             ServiceOrderDocument[]

  @@map("clients")
}

model ClientAddress {
  id               String   @id @default(uuid())
  clientId         String
  label            String   @default("Principal")
  streetAddress    String
  complement       String?
  latitude         Float?
  longitude        Float?
  sourceExtraction String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_addresses")
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  contactType String
  value       String
  label       String?
  name        String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotes      Quote[]

  @@map("client_contacts")
}

model Team {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  responsibleFor Client[]
  managers       User[]   @relation("TeamManagers")
  members        User[]   @relation("TeamMembers")

  @@map("teams")
}

model ClientTaxonomy {
  id               String             @id @default(uuid())
  kind             ClientTaxonomyKind
  name             String
  color            String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  clientsAsGroup   Client[]           @relation("ClientGroupTaxonomy")
  clientsAsSegment Client[]           @relation("ClientSegmentTaxonomy")

  @@unique([kind, name])
  @@map("client_taxonomies")
}

model Equipment {
  id                   String                @id @default(uuid())
  clientId             String
  type                 EquipmentType         @default(GENERATOR)
  brand                String?
  model                String?
  serialNumber         String?
  powerRating          String?
  installLocation      String?
  purchaseDate         DateTime?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  active               Boolean               @default(true)
  category             String?
  expirationDate       DateTime?
  identifier           String?               @unique
  name                 String?
  parentEquipmentId    String?
  photoUrl             String?
  qrCodeHash           String?               @unique
  qrCodeInherited      Boolean               @default(true)
  qrCodePublicRead     Boolean               @default(false)
  specifications       Json?
  warrantyEndDate      DateTime?
  equipmentAttachments EquipmentAttachment[]
  client               Client                @relation(fields: [clientId], references: [id])
  parentEquipment      Equipment?            @relation("EquipmentHierarchy", fields: [parentEquipmentId], references: [id])
  childEquipments      Equipment[]           @relation("EquipmentHierarchy")
  associatedProducts   Product[]
  workOrders           ServiceOrder[]        @relation("WorkOrderEquipment")
  technicalVisits      TechnicalVisit[]
  visitLinks           VisitEquipment[]
  warranties           Warranty[]

  @@index([clientId])
  @@map("equipments")
}

model EquipmentAttachment {
  id          String    @id @default(uuid())
  equipmentId String
  fileName    String
  fileUrl     String
  uploadedAt  DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_attachments")
}

model FailureCategory {
  id              String           @id @default(uuid())
  name            String           @unique
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  technicalVisits TechnicalVisit[]

  @@map("failure_categories")
}

model VisitTaskType {
  id                         String             @id @default(uuid())
  name                       String             @unique
  defaultChecklistTemplateId String?
  active                     Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  technicalVisits            TechnicalVisit[]
  defaultChecklistTemplate   ChecklistTemplate? @relation(fields: [defaultChecklistTemplateId], references: [id])

  @@map("visit_task_types")
}

model TechnicalVisit {
  id                  String              @id @default(uuid())
  clientId            String
  technicianId        String?
  visitDate           DateTime
  visitType           VisitType
  location            String
  description         String
  identifiedNeeds     String?
  suggestedScope      String?
  estimatedDeadline   String?
  estimatedValue      Decimal?            @db.Decimal(10, 2)
  attachments         String[]
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  attachmentsData     Json?
  checkinAccuracy     Float?
  checkinAt           DateTime?
  checkinLat          Float?
  checkinLng          Float?
  checkoutAccuracy    Float?
  checkoutAt          DateTime?
  checkoutLat         Float?
  checkoutLng         Float?
  responsibleIds      String[]
  userReport          String?
  chargeable          Boolean             @default(false)
  equipmentId         String?
  failureCategoryId   String?
  scheduledEnd        DateTime?
  scheduledStart      DateTime?
  status              VisitStatus         @default(SCHEDULED)
  actualValue         Decimal?            @db.Decimal(10, 2)
  checklist           Json[]
  checklistTemplateId String?
  createdById         String?
  externalCode        String?             @unique
  visitNumber         String?
  serviceCategory     String?             @default("ELECTRICAL")
  technicalData       Json?
  conclusionData      Json?
  technicianSignature String?             @db.Text
  clientSignature     String?             @db.Text
  clientSignerName    String?
  clientSignerDocument String?
  clientSignatureRefused Boolean?         @default(false)
  clientRefusalReason String?             @db.Text
  priority            VisitPriority       @default(MEDIUM)
  taskTypeId          String?
  expenses            Expense[]
  quotes              Quote[]
  linkedOrders        ServiceOrderVisit[]
  checklistTemplate   ChecklistTemplate?  @relation(fields: [checklistTemplateId], references: [id])
  client              Client              @relation(fields: [clientId], references: [id])
  createdBy           User?               @relation("VisitRequestedBy", fields: [createdById], references: [id])
  equipment           Equipment?          @relation(fields: [equipmentId], references: [id])
  failureCategory     FailureCategory?    @relation(fields: [failureCategoryId], references: [id])
  taskType            VisitTaskType?      @relation(fields: [taskTypeId], references: [id])
  technician          User?               @relation("CreatedVisits", fields: [technicianId], references: [id])
  equipments          VisitEquipment[]

  @@index([equipmentId])
  @@index([technicianId])
  @@map("technical_visits")
}

model VisitEquipment {
  id          String         @id @default(uuid())
  visitId     String
  equipmentId String
  createdAt   DateTime       @default(now())
  equipment   Equipment      @relation(fields: [equipmentId], references: [id])
  visit       TechnicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, equipmentId])
  @@map("visit_equipment")
}

model ChecklistTemplate {
  id               String            @id @default(uuid())
  name             String
  description      String?
  serviceOrderType ServiceOrderType?
  active           Boolean           @default(true)
  fields           Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  serviceOrders    ServiceOrder[]
  technicalVisits  TechnicalVisit[]
  visitTaskTypes   VisitTaskType[]

  @@map("checklist_templates")
}

model Quote {
  id                          String                @id @default(uuid())
  quoteNumber                 String                @unique
  type                        ServiceOrderType
  clientId                    String
  technicalVisitId            String?
  scope                       String
  createdById                 String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  notes                       String?
  reportedDefects             String?
  requestedServices           String?
  validUntil                  DateTime?
  paymentMethod               PaymentMethod?
  paymentTerms                String?
  salesRepId                  String?
  warrantyMonths              Int?
  paymentTermDays             Int?
  status                      QuoteStatus           @default(DRAFT)
  allowMultiplePaymentMethods Boolean               @default(false)
  contactId                   String?
  discountType                DiscountType          @default(VALOR_FIXO)
  discountValue               Decimal               @default(0.00) @db.Decimal(12, 2)
  externalCode                String?
  internalNotes               String?
  paymentMethodConfigId       String?
  requestDate                 DateTime              @default(now())
  subtotalAdditionalCosts     Decimal               @default(0.00) @db.Decimal(12, 2)
  subtotalProducts            Decimal               @default(0.00) @db.Decimal(12, 2)
  subtotalServices            Decimal               @default(0.00) @db.Decimal(12, 2)
  targetType                  QuoteTargetType       @default(CLIENTE)
  totalAmount                 Decimal               @default(0.00) @db.Decimal(12, 2)
  approvals                   Approval[]
  purchaseOrders              PurchaseOrder[]
  additionalCosts             QuoteAdditionalCost[]
  quoteAttachments            QuoteAttachment[]
  itemProducts                QuoteItemProduct[]
  itemServices                QuoteItemService[]
  quoteLines                  QuoteLine[]
  tasks                       QuoteTask[]
  client                      Client                @relation(fields: [clientId], references: [id])
  contact                     ClientContact?        @relation(fields: [contactId], references: [id])
  createdBy                   User                  @relation("CreatedQuotes", fields: [createdById], references: [id])
  paymentMethodConfig         PaymentMethodConfig?  @relation(fields: [paymentMethodConfigId], references: [id])
  salesRep                    User?                 @relation("QuoteSalesRep", fields: [salesRepId], references: [id])
  technicalVisit              TechnicalVisit?       @relation(fields: [technicalVisitId], references: [id])
  serviceOrder                ServiceOrder?

  @@map("quotes")
}

model QuoteLine {
  id          String           @id @default(uuid())
  quoteId     String
  type        QuoteLineType
  description String
  quantity    Decimal          @db.Decimal(10, 2)
  unitValue   Decimal          @db.Decimal(10, 2)
  totalValue  Decimal          @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  discount    Decimal          @default(0) @db.Decimal(10, 2)
  billingType ItemBillingType? @default(BILLED_SEPARATELY)
  quote       Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_lines")
}

model QuoteItemProduct {
  id             String          @id @default(uuid())
  quoteId        String
  productId      String
  quantity       Decimal         @db.Decimal(10, 2)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  totalPrice     Decimal         @db.Decimal(12, 2)
  billingType    ItemBillingType @default(BILLED_SEPARATELY)
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id])
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_item_products")
}

model QuoteItemService {
  id                String   @id @default(uuid())
  quoteId           String
  serviceId         String
  quantity          Decimal  @db.Decimal(10, 2)
  unitPrice         Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  customObservation String?
  createdAt         DateTime @default(now())
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service           Service  @relation(fields: [serviceId], references: [id])

  @@map("quote_item_services")
}

model QuoteAdditionalCost {
  id          String   @id @default(uuid())
  quoteId     String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_additional_costs")
}

model QuoteTask {
  id                     String   @id @default(uuid())
  quoteId                String
  taskCode               String?
  taskType               String
  executionDate          DateTime
  assignedCollaboratorId String?
  createdAt              DateTime @default(now())
  assignedCollaborator   User?    @relation("QuoteTaskAssignee", fields: [assignedCollaboratorId], references: [id])
  quote                  Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_tasks")
}

model QuoteAttachment {
  id           String   @id @default(uuid())
  quoteId      String
  fileName     String
  fileUrl      String
  uploadedById String
  showToClient Boolean  @default(false)
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("QuoteAttachmentUploader", fields: [uploadedById], references: [id])

  @@map("quote_attachments")
}

model Service {
  id                    String                 @id @default(uuid())
  title                 String
  category              String?
  unit                  String?                @default("sv")
  price                 Decimal                @default(0.00) @db.Decimal(12, 2)
  externalCode          String?                @unique
  defaultObservation    String?
  observationEditable   Boolean                @default(true)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  quoteItemServices     QuoteItemService[]
  templates             ServiceTemplate[]
  workOrderItemServices WorkOrderItemService[]

  @@map("services")
}

model ServiceTemplate {
  id              String   @id @default(uuid())
  serviceId       String
  title           String
  templateContent String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_templates")
}

model PaymentMethodConfig {
  id                   String   @id @default(uuid())
  description          String
  maxInstallments      Int      @default(1)
  bankAccount          String
  gatewayOrModality    String
  feePercentage        Decimal  @default(0.00) @db.Decimal(5, 2)
  feeFixedAmount       Decimal  @default(0.00) @db.Decimal(10, 2)
  settlementPeriodDays Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  quotes               Quote[]

  @@map("payment_method_configs")
}

model ServiceOrder {
  id                     String                  @id @default(uuid())
  orderNumber            String                  @unique
  quoteId                String                  @unique
  clientId               String
  status                 ServiceOrderStatus      @default(AWAITING_MATERIALS)
  scope                  String
  requiredResources      Json?
  deadline               DateTime?
  responsibleIds         String[]
  checklist              Json[]
  checklistTemplateId    String?
  progress               Int                     @default(0)
  attachments            String[]
  createdById            String
  paymentStatus          PaymentStatus           @default(PENDING)
  completedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  assignedCollaboratorId String?
  checkinTime            DateTime?
  checkoutTime           DateTime?
  displacementCostReal   Decimal                 @default(0.00) @db.Decimal(12, 2)
  equipmentId            String?
  grossProfitReal        Decimal                 @default(0.00) @db.Decimal(12, 2)
  grossRevenueReal       Decimal                 @default(0.00) @db.Decimal(12, 2)
  hourlyRateSnapshot     Decimal                 @default(0.00) @db.Decimal(12, 2)
  kmRateSnapshot         Decimal                 @default(0.00) @db.Decimal(12, 2)
  laborCostReal          Decimal                 @default(0.00) @db.Decimal(12, 2)
  totalKmTraveled        Decimal                 @default(0.00) @db.Decimal(8, 2)
  totalMaterialCostReal  Decimal                 @default(0.00) @db.Decimal(12, 2)
  totalWorkedHours       Decimal                 @default(0.00) @db.Decimal(6, 2)
  art                    ART?
  delivery               Delivery?
  expenses               Expense[]
  materialRequests       MaterialRequest[]
  notasFiscais           NotaFiscal[]
  items                  ServiceOrderProduct[]
  linkedVisits           ServiceOrderVisit[]
  assignedCollaborator   User?                   @relation("AssignedWorkOrders", fields: [assignedCollaboratorId], references: [id])
  checklistTemplate      ChecklistTemplate?      @relation(fields: [checklistTemplateId], references: [id])
  client                 Client                  @relation(fields: [clientId], references: [id])
  createdBy              User                    @relation("CreatedServiceOrders", fields: [createdById], references: [id])
  equipment              Equipment?              @relation("WorkOrderEquipment", fields: [equipmentId], references: [id])
  quote                  Quote                   @relation(fields: [quoteId], references: [id])
  executionLogs          WorkOrderExecutionLog[]
  itemServices           WorkOrderItemService[]
  signature              WorkOrderSignature?
  documents              ServiceOrderDocument[]

  @@map("service_orders")
}

model WorkOrderItemService {
  id               String       @id @default(uuid())
  serviceOrderId   String
  serviceId        String
  quantity         Decimal      @db.Decimal(10, 2)
  unitPrice        Decimal      @db.Decimal(12, 2)
  scopeObservation String?
  completed        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  service          Service      @relation(fields: [serviceId], references: [id])
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_item_services")
}

model WorkOrderExecutionLog {
  id             String       @id @default(uuid())
  serviceOrderId String
  userId         String
  actionType     String
  recordedAt     DateTime     @default(now())
  latitude       Float?
  longitude      Float?
  odometerKm     Decimal?     @db.Decimal(10, 2)
  notes          String?
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
